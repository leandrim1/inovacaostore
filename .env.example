# Banco Postgres. Ao criar um banco na Vercel (Storage > Postgres), copie os
# valores de POSTGRES_PRISMA_URL (pooled, use aqui) e POSTGRES_URL_NON_POOLING
# (conexão direta, usada só para rodar migrations). Para desenvolvimento local
# sem Vercel, aponte as duas para o mesmo Postgres local.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/inovacaostore"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/inovacaostore"

# Upload de imagens de produto. Ao criar um Blob store na Vercel (Storage >
# Blob) essa variável é preenchida automaticamente no projeto. Sem ela, o
# upload cai para a pasta local server/uploads/ (funciona em dev, não em
# produção na Vercel — o disco lá é temporário).
BLOB_READ_WRITE_TOKEN=""

JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
NODE_ENV=development

# Usados apenas pelo script de seed para criar o primeiro usuário admin
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@inovacaostore.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# Envio real de e-mail (cadastro de clientes: código de verificação e
# redefinição de senha). Funciona com qualquer SMTP — exemplo com Gmail:
# 1. Ative a verificação em duas etapas na conta Google usada.
# 2. Gere uma "Senha de app" em myaccount.google.com/apppasswords.
# 3. Use o e-mail em SMTP_USER e a senha de app (16 caracteres) em SMTP_PASSWORD.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="seuemail@gmail.com"
SMTP_PASSWORD="senha-de-app-de-16-caracteres"
SMTP_FROM_NAME="Inovação Store"
