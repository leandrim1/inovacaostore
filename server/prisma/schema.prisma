generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  /// Sessões emitidas antes deste instante são rejeitadas. É o que permite
  /// revogar um JWT roubado — sem isso, um token vazado vale até expirar.
  sessionsValidFrom DateTime?
  auditLogs    AdminAuditLog[]
}

/// Trilha de auditoria das ações administrativas (quem fez o quê, quando e
/// de onde). Guarda apenas metadados — nunca senhas, tokens ou segredos.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String
  action     String
  resource   String
  resourceId String?
  detail     String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  order       Int       @default(0)
  products    Product[]
  promotions  Promotion[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  description    String           @default("")
  features       String           @default("[]") // JSON string array
  tags           String           @default("[]") // JSON string array: novo, mais-vendido, importado, ultimas-unidades
  price          Float
  compareAtPrice Float?
  costPrice      Float            @default(0) // custo de aquisição/produção, usado no cálculo de lucro
  weightKg       Float            @default(0)
  volumeM3       Float            @default(0)
  sku            String           @unique
  featured       Boolean          @default(false)
  active         Boolean          @default(true)
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  promotions     PromotionProduct[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  desktopSettings Json?
  mobileSettings  Json?
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  colorHex   String      @default("#141414")
  size       String
  stock      Int         @default(0)
  sku        String?     @unique
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, color, size])
}

model Customer {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  phone              String              @default("")
  passwordHash       String?
  emailVerified      Boolean             @default(false)
  /// Ver AdminUser.sessionsValidFrom. Atualizado na troca/redefinição de
  /// senha, para que a sessão de quem roubou o acesso morra junto.
  sessionsValidFrom  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  testimonials       Testimonial[]
}

model Testimonial {
  id String @id @default(cuid())
  // Nulo nos depoimentos que vieram do conteúdo fixo antigo (seed) — os
  // enviados pelo site sempre têm um cliente por trás.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Snapshot do nome no momento do envio: o admin pode ajustar como o nome
  // aparece no site sem alterar o cadastro do cliente.
  name    String
  city    String @default("")
  rating  Int
  quote   String
  // pendente = aguardando moderação; só "aprovado" aparece no site.
  status   String  @default("pendente")
  featured Boolean @default(false)
  order    Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  usedAt     DateTime?

  @@index([customerId])
}

model PasswordReset {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?

  @@index([customerId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  subtotal      Float
  /// Soma de (preço de tabela - preço promocional) x quantidade. É apenas
  /// informativo: `subtotal` já é a soma dos itens COM a promoção aplicada,
  /// então `total` continua sendo max(0, subtotal - discount) + frete.
  promotionDiscount Float   @default(0)
  discount      Float       @default(0)
  couponCode    String?
  shippingPrice      Float       @default(0)
  shippingLabel      String?
  shippingDistanceKm Float?
  shippingMethod     String?
  total              Float
  paymentMethod String
  status        String      @default("pendente")
  cep           String
  street        String
  number        String
  complement    String      @default("")
  neighborhood  String
  city          String
  state         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  color       String
  size        String
  /// Preço realmente cobrado por unidade (já com a promoção aplicada).
  price       Float
  /// Preço de tabela no momento do pedido. Só é preenchido quando havia
  /// promoção — null significa "não estava em promoção".
  originalPrice  Float?
  promotionId    String?
  promotionTitle String?
  unitCost    Float          @default(0) // snapshot de Product.costPrice no momento do pedido
  quantity    Int
}

model SiteSettings {
  id                String   @id @default("singleton")
  heroEyebrow       String
  heroTitle         String
  heroDescription   String
  heroCtaLabel      String
  heroCtaUrl        String
  whatsappNumber    String
  whatsappMessage   String
  contactEmail      String
  addressStreet     String   @default("Rua Ouro Preto, 784")
  addressCity       String   @default("Patos de Minas")
  addressState      String   @default("MG")
  addressZip        String   @default("38700-000")
  announcementItem1 String
  announcementItem2 String
  announcementItem3 String
  announcementItem4 String
  updatedAt         DateTime @updatedAt
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  // Enquadramento (posição/zoom/rotação) definido pelo admin, separado por
  // breakpoint — null = usa o comportamento padrão do componente (sem alterar
  // o design atual de imagens que nunca foram ajustadas).
  desktopSettings Json?
  mobileSettings  Json?
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  highlight   String // ex.: "20% OFF"
  description String    @default("")
  ctaLabel    String    @default("Compre agora")
  ctaUrl      String    @default("/")
  imageUrl    String?
  desktopSettings Json?
  mobileSettings  Json?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  order       Int       @default(0)

  // --- Desconto de verdade sobre os produtos ---
  // discountValue = 0 significa "promoção só de banner": era assim que todas
  // as promoções funcionavam antes, então o default mantém o comportamento.
  discountType  String  @default("percent") // "percent" | "fixed"
  discountValue Float   @default(0)
  discountScope String  @default("all") // "all" | "category" | "products"
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products      PromotionProduct[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, startsAt, endsAt])
}

/// Produtos escolhidos a dedo por uma promoção (discountScope = "products").
/// Tabela de ligação explícita em vez da relação implícita do Prisma: o
/// nome e as chaves ficam previsíveis na migration escrita à mão.
model PromotionProduct {
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String    @default("")
  percentOff  Float
  active      Boolean   @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  // null = sem limite. maxRedemptionsPerCustomer existe para que
  // "quantos clientes podem usar" não seja burlado por um único cliente
  // aplicando o mesmo código em vários pedidos.
  maxRedemptions            Int?
  maxRedemptionsPerCustomer Int?     @default(1)
  // Contador dedicado (em vez de contar Order por couponCode) para permitir
  // incremento atômico dentro da transação do pedido — mesmo padrão usado
  // no controle de estoque, evitando corrida quando vários clientes tentam
  // usar um cupom de "primeiras N vagas" ao mesmo tempo.
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingTier {
  id        String   @id @default(cuid())
  minKm     Float
  maxKm     Float? // null = sem limite superior (última faixa)
  price     Float
  costPrice Float? // custo real pago à transportadora nessa faixa (null = não configurado)
  etaLabel  String? // ex.: "3 a 5 dias úteis"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingSettings {
  id                        String   @id @default("singleton")
  enabled                   Boolean  @default(true)
  originLat                 Float
  originLng                 Float
  freeShippingMinOrderValue Float?
  freeShippingRegions       String   @default("[]") // JSON: [{ state, city? }]
  minShippingPrice          Float    @default(0)
  freeWeightKg              Float    @default(0)
  pricePerExtraKg           Float    @default(0)
  freeVolumeM3              Float    @default(0)
  pricePerExtraM3           Float    @default(0)
  fallbackFlatPrice         Float    @default(25)
  updatedAt                 DateTime @updatedAt
}

model CepGeocodeCache {
  cep       String   @id
  lat       Float
  lng       Float
  city      String
  state     String
  source    String
  createdAt DateTime @default(now())
}

model FinanceSettings {
  id                     String   @id @default("singleton")
  paymentFeePixPct       Float    @default(0)
  paymentFeeCardPct      Float    @default(0)
  paymentFeeBoletoPct    Float    @default(0)
  paymentFeeOtherPct     Float    @default(0)
  platformFeePct         Float    @default(0)
  includeCancelledOrders Boolean  @default(false)
  includeRefundedOrders  Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  category    String // embalagem | marketing | comissao | operacional | outro
  description String   @default("")
  amount      Float
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([occurredAt])
}
