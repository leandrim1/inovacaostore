generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  description    String           @default("")
  features       String           @default("[]") // JSON string array
  tags           String           @default("[]") // JSON string array: novo, mais-vendido, importado, ultimas-unidades
  price          Float
  compareAtPrice Float?
  sku            String           @unique
  featured       Boolean          @default(false)
  active         Boolean          @default(true)
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  colorHex   String      @default("#141414")
  size       String
  stock      Int         @default(0)
  sku        String?     @unique
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, color, size])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  subtotal      Float
  discount      Float       @default(0)
  couponCode    String?
  shippingPrice Float       @default(0)
  shippingLabel String?
  total         Float
  paymentMethod String
  status        String      @default("pendente")
  cep           String
  street        String
  number        String
  complement    String      @default("")
  neighborhood  String
  city          String
  state         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  color       String
  size        String
  price       Float
  quantity    Int
}
