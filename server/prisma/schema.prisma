generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  description    String           @default("")
  features       String           @default("[]") // JSON string array
  tags           String           @default("[]") // JSON string array: novo, mais-vendido, importado, ultimas-unidades
  price          Float
  compareAtPrice Float?
  costPrice      Float            @default(0) // custo de aquisição/produção, usado no cálculo de lucro
  weightKg       Float            @default(0)
  volumeM3       Float            @default(0)
  sku            String           @unique
  featured       Boolean          @default(false)
  active         Boolean          @default(true)
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  colorHex   String      @default("#141414")
  size       String
  stock      Int         @default(0)
  sku        String?     @unique
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, color, size])
}

model Customer {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  phone              String              @default("")
  passwordHash       String?
  emailVerified      Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
}

model EmailVerification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  usedAt     DateTime?

  @@index([customerId])
}

model PasswordReset {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  usedAt     DateTime?

  @@index([customerId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  subtotal      Float
  discount      Float       @default(0)
  couponCode    String?
  shippingPrice      Float       @default(0)
  shippingLabel      String?
  shippingDistanceKm Float?
  shippingMethod     String?
  total              Float
  paymentMethod String
  status        String      @default("pendente")
  cep           String
  street        String
  number        String
  complement    String      @default("")
  neighborhood  String
  city          String
  state         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  productName String
  color       String
  size        String
  price       Float
  unitCost    Float          @default(0) // snapshot de Product.costPrice no momento do pedido
  quantity    Int
}

model SiteSettings {
  id                String   @id @default("singleton")
  heroEyebrow       String
  heroTitle         String
  heroDescription   String
  heroCtaLabel      String
  heroCtaUrl        String
  whatsappNumber    String
  whatsappMessage   String
  contactEmail      String
  announcementItem1 String
  announcementItem2 String
  announcementItem3 String
  announcementItem4 String
  updatedAt         DateTime @updatedAt
}

model HeroImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  highlight   String // ex.: "20% OFF"
  description String    @default("")
  ctaLabel    String    @default("Compre agora")
  ctaUrl      String    @default("/")
  imageUrl    String?
  endsAt      DateTime?
  active      Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String    @default("")
  percentOff  Float
  active      Boolean   @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  // null = sem limite. maxRedemptionsPerCustomer existe para que
  // "quantos clientes podem usar" não seja burlado por um único cliente
  // aplicando o mesmo código em vários pedidos.
  maxRedemptions            Int?
  maxRedemptionsPerCustomer Int?     @default(1)
  // Contador dedicado (em vez de contar Order por couponCode) para permitir
  // incremento atômico dentro da transação do pedido — mesmo padrão usado
  // no controle de estoque, evitando corrida quando vários clientes tentam
  // usar um cupom de "primeiras N vagas" ao mesmo tempo.
  usedCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingTier {
  id        String   @id @default(cuid())
  minKm     Float
  maxKm     Float? // null = sem limite superior (última faixa)
  price     Float
  costPrice Float? // custo real pago à transportadora nessa faixa (null = não configurado)
  etaLabel  String? // ex.: "3 a 5 dias úteis"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingSettings {
  id                        String   @id @default("singleton")
  enabled                   Boolean  @default(true)
  originLat                 Float
  originLng                 Float
  freeShippingMinOrderValue Float?
  freeShippingRegions       String   @default("[]") // JSON: [{ state, city? }]
  minShippingPrice          Float    @default(0)
  freeWeightKg              Float    @default(0)
  pricePerExtraKg           Float    @default(0)
  freeVolumeM3              Float    @default(0)
  pricePerExtraM3           Float    @default(0)
  fallbackFlatPrice         Float    @default(25)
  updatedAt                 DateTime @updatedAt
}

model CepGeocodeCache {
  cep       String   @id
  lat       Float
  lng       Float
  city      String
  state     String
  source    String
  createdAt DateTime @default(now())
}

model FinanceSettings {
  id                     String   @id @default("singleton")
  paymentFeePixPct       Float    @default(0)
  paymentFeeCardPct      Float    @default(0)
  paymentFeeBoletoPct    Float    @default(0)
  paymentFeeOtherPct     Float    @default(0)
  platformFeePct         Float    @default(0)
  includeCancelledOrders Boolean  @default(false)
  includeRefundedOrders  Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  category    String // embalagem | marketing | comissao | operacional | outro
  description String   @default("")
  amount      Float
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([occurredAt])
}
